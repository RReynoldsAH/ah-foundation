<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="keywords" content="{{ keywords }}">
{%- set siteUrl = site.url | replace(r/\/+$/, "") %}
{%- set pageUrl = siteUrl + page.url %}
<link rel="canonical" href="{{ pageUrl }}">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ siteUrl }}/assets/brand/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.full_name }} logo">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ siteUrl }}/assets/brand/og-image.png">

<link rel="icon" href="favicon.ico" sizes="48x48">
<link rel="icon" href="assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="site.webmanifest">
<meta name="theme-color" content="#1a4a35">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=Poppins:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css?v={{ buildStamp }}">

<script type="application/ld+json">
{%- if isHome %}
{
  "@context": "https://schema.org",
  "@type": "NGO",
  "name": {{ site.name | dump | safe }},
  "url": {{ pageUrl | dump | safe }},
  "description": "The AH Foundation partners with faith-based and nonprofit organizations to strengthen communities through purposeful relationships, investment, and shared impact.",
  "slogan": "Sowing Into the Communities Where We Do Business",
  "parentOrganization": {
    "@type": "Organization",
    "name": "INTEGRITY"
  }
}
{%- else %}
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":{{ (siteUrl + "/") | dump | safe }}},
    {"@type":"ListItem","position":2,"name":{{ breadcrumbName | dump | safe }},"item":{{ pageUrl | dump | safe }}}
  ]
}
{%- endif %}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<button class="back-to-top" aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<script src="js/main.js?v={{ buildStamp }}"></script>
</body>
</html>
