{%- set cta = headerCta or { href: "approach.html", label: "Learn About Our Partnership Approach" } -%}
<header class="site-header">
  <div class="container">
    <a href="index.html" class="brand" aria-label="{{ site.name }} — home">
      <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="32" fill="#123526"/>
        <path d="M32 46V29" stroke="#D9B45A" stroke-width="3" stroke-linecap="round"/>
        <path d="M32 30c0-8 6-13 14-13 0 8-6 13-14 13Z" fill="#C99A2E"/>
        <path d="M32 34c0-7-6-11-13-11 0 7 6 11 13 11Z" fill="#E8CD8A"/>
        <path d="M24 46h16" stroke="#D9B45A" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <span class="brand-text">{{ site.name }}<span>{{ site.tagline }}</span></span>
    </a>
    <nav class="main-nav" aria-label="Primary">
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="about.html">About</a></li>
        <li><a href="partners.html">Our Partners</a></li>
        <li><a href="impact.html">Our Impact</a></li>
        <li><a href="contact.html">Contact</a></li>
      </ul>
    </nav>
    <a href="{{ cta.href }}" class="btn btn-gold header-cta">{{ cta.label }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
    </a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>

<div class="mobile-nav" aria-hidden="true">
  <div class="mobile-nav-top">
    <button class="mobile-nav-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav aria-label="Mobile">
    <ul>
      <li><a href="index.html">Home</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="partners.html">Our Partners</a></li>
      <li><a href="impact.html">Our Impact</a></li>
      <li><a href="contact.html">Contact</a></li>
    </ul>
  </nav>
  <a href="{{ cta.href }}" class="btn btn-gold btn-block">{{ cta.label }}</a>
</div>
