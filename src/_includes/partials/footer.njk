<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="index.html" class="brand">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="32" fill="#123526"/>
            <path d="M32 46V29" stroke="#D9B45A" stroke-width="3" stroke-linecap="round"/>
            <path d="M32 30c0-8 6-13 14-13 0 8-6 13-14 13Z" fill="#C99A2E"/>
            <path d="M32 34c0-7-6-11-13-11 0 7 6 11 13 11Z" fill="#E8CD8A"/>
            <path d="M24 46h16" stroke="#D9B45A" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <span class="brand-text">{{ site.name }}</span>
        </a>
        <p>{{ site.footer_blurb }}</p>
        {%- if site.social.facebook or site.social.instagram or site.social.linkedin %}
        <div class="social-row">
          {%- if site.social.facebook %}
          <a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="{{ site.name }} on Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3a4 4 0 00-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 011-1z"/></svg></a>
          {%- endif %}
          {%- if site.social.instagram %}
          <a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="{{ site.name }} on Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>
          {%- endif %}
          {%- if site.social.linkedin %}
          <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="{{ site.name }} on LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10.5v6.5M7.5 7.3v.1"/><path d="M11 17v-4.2a2.3 2.3 0 014.6 0V17M11 10.5V17"/></svg></a>
          {%- endif %}
        </div>
        {%- endif %}
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="about.html">About the Foundation</a></li>
          <li><a href="partners.html">Our Partners</a></li>
          <li><a href="impact.html">Our Impact</a></li>
          <li><a href="approach.html">Partnership Approach</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Get Involved</h4>
        <ul>
          <li><a href="approach.html">How Partnerships Work</a></li>
          <li><a href="contact.html">Contact the Foundation</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li>Partnership Inquiries:<br>{{ site.contact.partnership_contact_name }}, {{ site.contact.partnership_contact_title }}</li>
          {%- if site.contact.general_email %}
          <li><a href="mailto:{{ site.contact.general_email }}">{{ site.contact.general_email }}</a></li>
          {%- endif %}
          <li><a href="contact.html">Send a message</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{{ site.copyright }}</p>
      {%- if site.footer_credit %}
      <p>{{ site.footer_credit }}</p>
      {%- endif %}
    </div>
  </div>
</footer>
